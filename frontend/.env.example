# Cấu hình kết nối Frontend SignVision với Backend Python SVM (LinearSVC C=0.01)
# Sao chép file này thành .env.local nếu muốn tùy chỉnh.

# Chế độ chạy model: "api" (gọi máy chủ Python SVM)
VITE_MODEL_MODE=api

# Địa chỉ endpoint dự đoán và kiểm tra trạng thái của máy chủ Python SVM
VITE_API_URL=http://localhost:8000/predict
VITE_API_HEALTH_URL=http://localhost:8000/health

# Định dạng gửi lên API: "image" (ảnh vùng bàn tay JPEG base64 không lật gương)
VITE_MODEL_INPUT=image

# Chế độ lấy vùng bàn tay (ROI):
# - "mediapipe": Dùng MediaPipe HandLandmarker phát hiện tay, chọn 1 bàn tay lớn nhất và cắt có khoảng đệm
# - "fixed_box": Dùng khung hướng dẫn vuông cố định ở giữa màn hình (dự phòng khi không dùng bộ phát hiện tay)
VITE_ROI_MODE=mediapipe

# Tốc độ gửi yêu cầu dự đoán (khung hình/giây, khuyến nghị 3-5 FPS)
VITE_PREDICTION_HZ=4

# Số kết quả gần nhất dùng để bỏ phiếu đa số làm mượt hiển thị (1 = tắt làm mượt, 3 = mặc định)
VITE_SMOOTHING_WINDOW=3

# Số lần dự đoán ổn định liên tiếp để tự động ghép ký hiệu vào ô câu
VITE_STABILITY=4

# Tỉ lệ khoảng đệm quanh khung bàn tay khi cắt (0.28 = đệm 28% kích thước bàn tay)
VITE_HAND_PADDING_RATIO=0.28

# Đường dẫn danh sách 36 nhãn dự phòng tĩnh
VITE_LABELS_URL=/model/labels.json
